# VoiceShield-AI Backend – Environment Variables
# Copy this file to .env and fill in your values.

APP_NAME=VoiceShield-AI
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Database (Render provides this automatically via render.yaml)
DATABASE_URL=postgresql://user:password@host:5432/voiceshield

# CORS – comma-separated list of allowed frontend origins
# After deploying to Vercel, add your URL here:
CORS_ORIGINS=https://your-project.vercel.app

# Storage (leave as 'local' for free Render tier)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/audio

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# File upload
MAX_UPLOAD_SIZE_MB=50
