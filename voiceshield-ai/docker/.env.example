# Copy this file to `docker/.env` before running `docker compose up`.

ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg://voiceshield:voiceshield@db:5432/voiceshield

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/audio
# For MinIO/S3 instead:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://minio:9000
# S3_BUCKET=voiceshield-audio
# S3_ACCESS_KEY=voiceshield
# S3_SECRET_KEY=voiceshield123

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Limits ---
MAX_UPLOAD_SIZE_MB=200
DEFAULT_SEGMENT_LENGTH_S=5.0
DEFAULT_SAMPLE_RATE=16000

# --- ML model checkpoints (optional — leave unset to run in Simulation Mode) ---
SPECTROGRAM_MODEL_PATH=
WAVLM_MODEL_PATH=
WHISPER_MODEL_SIZE=base

LOG_LEVEL=INFO
